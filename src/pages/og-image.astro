---
import "../styles/global.css";

const icons = [
  { ok: true, d: `<path d="M9 5C7.3 5 6.5 5.9 6.5 7.5v2.2c0 1.2-.7 2-2 2.3 1.3.3 2 1.1 2 2.3v2.2c0 1.6.8 2.5 2.5 2.5M15 5c1.7 0 2.5.9 2.5 2.5v2.2c0 1.2.7 2 2 2.3-1.3.3-2 1.1-2 2.3v2.2c0 1.6-.8 2.5-2.5 2.5"/>` },
  { ok: true, d: `<path d="M7 3.5h7l4 4v13H7z"/><path d="M14 3.5v4h4M9.5 11.5h6M9.5 14.5h6M9.5 17.5h3.5"/>` },
  { ok: true, d: `<rect x="3.5" y="5" width="17" height="14" rx="2.5"/><path d="m7.5 10 2.5 2.2-2.5 2.3M12.5 15h4"/>` },
  { ok: false, d: `<rect x="3.5" y="5.5" width="17" height="13" rx="3.5"/><path d="M10.5 9.3v5.4l4.6-2.7z" fill="currentColor"/>` },
  { ok: false, d: `<path d="M5 6.5c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2v7c0 1.1-.9 2-2 2h-6l-4 3.5v-3.5H7c-1.1 0-2-.9-2-2z"/>` },
  { ok: false, d: `<rect x="4" y="4" width="7" height="7" rx="2"/><rect x="13" y="4" width="7" height="7" rx="2"/><rect x="4" y="13" width="7" height="7" rx="2"/><path d="M16.5 19.6s-3.4-2-3.4-4.2c0-1 .8-1.8 1.8-1.8.7 0 1.3.4 1.6 1 .3-.6.9-1 1.6-1 1 0 1.8.8 1.8 1.8 0 2.2-3.4 4.2-3.4 4.2z" fill="currentColor" stroke="none"/>` },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>FocusLock share image</title>
  </head>
  <body>
    <div class="og">
      <div class="left">
        <div class="brand"><img src="/favicon.svg" alt="" width="44" height="44" /> FocusLock</div>
        <p class="cmd"><span>$</span> focuslock start --minutes 25</p>
        <h1>Switch freely.<br />Get blocked from<br /><em>everything else.</em></h1>
        <p class="sub">Focus mode for developers · macOS menu bar app</p>
      </div>

      <div class="desk">
        <div class="mb">
          <b>Editor</b><span>File</span><span>Edit</span>
          <i class="sp"></i>
          <span class="cnt">blocked: <b>3</b></span>
          <span class="timer">🔒 24:59</span>
        </div>
        <div class="win">
          <div class="bar"><i></i><i></i><i></i><span>main.rs — focus</span></div>
          <pre><span class="n">1</span> <b>fn</b> main() {"{"}
<span class="n">2</span>     <b>let</b> s = Session::start(<em>25</em>);
<span class="n">3</span>     <b>while</b> s.running() {"{"}
<span class="n">4</span>         focus(); <u>// you are here</u>
<span class="n">5</span>     {"}"}
<span class="n">6</span> {"}"}</pre>
        </div>
        <div class="toast">
          <span class="ti">✕</span>
          <span><b>Nope. 24 min left.</b><br />Video is blocked during your focus session.</span>
        </div>
        <div class="dock">
          {icons.map((ic, i) => (
            <>
              {i === 3 && <span class="sep" />}
              <span class:list={["app", { bounced: i === 3 }]}>
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={ic.d} />
              </span>
            </>
          ))}
        </div>
      </div>
    </div>
  </body>
</html>

<style is:global>
  html, body { margin: 0; background: #0a0a0b; }
  .og {
    width: 1200px; height: 630px; box-sizing: border-box; padding: 64px 0 64px 72px; overflow: hidden;
    display: grid; grid-template-columns: 560px 1fr; gap: 40px; align-items: center; color: #f2f2f0;
    font-family: var(--font-sans); font-optical-sizing: auto;
    background:
      radial-gradient(50% 60% at 85% 45%, rgb(198 255 61 / 0.13), transparent 70%),
      radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.07) 1px, transparent 0) 0 0 / 24px 24px, #0a0a0b;
  }
  .brand { display: flex; align-items: center; gap: 12px; font-weight: 800; font-size: 26px; letter-spacing: -0.02em; }
  .cmd { margin: 34px 0 10px; font: 18px var(--font-mono); color: #8a8a8e; }
  .cmd span { color: #c6ff3d; }
  h1 { margin: 0; font-size: 66px; line-height: 0.98; font-weight: 800; letter-spacing: -0.045em; padding-bottom: 0.1em; }
  h1 em { font-style: normal; color: #c6ff3d; }
  .sub { margin: 22px 0 0; font: 17px var(--font-mono); color: #8a8a8e; }

  .desk {
    position: relative; height: 470px; border-radius: 18px 0 0 18px; border: 1px solid #2a2a2e; border-right: 0;
    background: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.09) 1px, transparent 0) 0 0 / 18px 18px, #0e0e10;
    box-shadow: 0 40px 100px -30px #000; overflow: hidden;
  }
  .mb { display: flex; gap: 16px; align-items: center; height: 36px; padding: 0 16px; background: rgb(20 20 22 / 0.9); border-bottom: 1px solid #222226; font-size: 14px; color: #8a8a8e; }
  .mb > b { color: #f2f2f0; }
  .mb .sp { flex: 1; }
  .cnt { font: 13px var(--font-mono); }
  .cnt b { color: #ff4d2e; }
  .timer { font: 700 17px var(--font-mono); color: #c6ff3d; padding: 3px 10px; border-radius: 7px; background: rgb(198 255 61 / 0.12); }
  .win { position: absolute; left: 34px; top: 72px; width: 420px; border-radius: 12px; overflow: hidden; background: #161618; border: 1px solid #333338; box-shadow: 0 24px 60px -20px #000; }
  .bar { display: flex; align-items: center; gap: 7px; height: 32px; padding: 0 12px; background: #1e1e21; border-bottom: 1px solid #2a2a2e; font-size: 12px; color: #8a8a8e; }
  .bar i { width: 11px; height: 11px; border-radius: 50%; background: #ff5f57; }
  .bar i:nth-child(2) { background: #febc2e; }
  .bar i:nth-child(3) { background: #28c840; }
  .bar span { margin-left: 70px; }
  .win pre { margin: 0; padding: 14px 16px; font: 14px/1.8 var(--font-mono); color: #d6d6d2; }
  .win .n { color: #4a4a50; }
  .win b { color: #c6ff3d; font-weight: 600; }
  .win em { font-style: normal; color: #ffb38a; }
  .win u { text-decoration: none; color: #8e8e94; }
  .toast {
    position: absolute; right: 26px; top: 56px; width: 300px; display: flex; gap: 12px; align-items: center;
    padding: 12px 14px; border-radius: 14px; background: rgb(40 40 44 / 0.96); border: 1px solid #3a3a40;
    font-size: 14px; line-height: 1.35; color: #b5b5b8; box-shadow: 0 18px 40px -10px #000; rotate: -2deg;
  }
  .toast b { color: #f2f2f0; }
  .ti { flex: none; width: 34px; height: 34px; border-radius: 9px; display: grid; place-items: center; background: #0a0a0b; color: #ff4d2e; box-shadow: 0 0 0 2px #ff4d2e; font-weight: 800; }
  .dock { position: absolute; left: 50%; bottom: 18px; translate: -50% 0; display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 20px; background: rgb(28 28 31 / 0.9); border: 1px solid rgb(255 255 255 / 0.08); }
  .app { width: 52px; height: 52px; border-radius: 13px; display: grid; place-items: center; background: linear-gradient(180deg, #2a2a2f, #1d1d21); border: 1px solid rgb(255 255 255 / 0.07); color: #f2f2f0; }
  .app.bounced { box-shadow: 0 0 0 2px #ff4d2e; translate: 0 -10px; }
  .sep { width: 1px; height: 40px; background: rgb(255 255 255 / 0.12); margin: 0 4px; }
</style>
