---
import { site, isPlaceholder } from "../config";

const ready = !isPlaceholder(site.links.download);
const { requirements, version } = site;
---

<div class="cta">
  <div class="cta-stack grid">
    <div class="cta-mac [grid-area:1/1]">
      {
        ready ? (
          <a class="btn-primary" href={site.links.download} download data-track="download-dmg">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14" /></svg>
            Download for macOS
          </a>
        ) : (
          <button class="btn-primary" type="button" disabled>
            Coming soon
          </button>
        )
      }
    </div>
    <p class="cta-nonmac [grid-area:1/1] self-center rounded-xl border border-line bg-surface px-4 py-3 text-sm text-muted" hidden>
      <strong class="text-ink">FocusLock is macOS-only for now.</strong> Open this page on your Mac to download it.
    </p>
  </div>
  <p class="mt-3 font-mono text-xs text-muted">
    Requires macOS {requirements.macos}+ · {requirements.chip} · v{version}
  </p>
</div>

<script>
  function isMac(): boolean {
    const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
    const platform = nav.userAgentData?.platform || navigator.platform || navigator.userAgent;
    return /mac/i.test(platform) && navigator.maxTouchPoints < 2;
  }
  if (!isMac()) {
    for (const cta of document.querySelectorAll<HTMLElement>(".cta")) {
      cta.querySelector<HTMLElement>(".cta-mac")!.style.visibility = "hidden";
      cta.querySelector<HTMLElement>(".cta-nonmac")!.hidden = false;
    }
  }
</script>
