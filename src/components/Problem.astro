---
import SectionHead from "./SectionHead.astro";

const start = [
  { t: "docs: Vec<T>", ok: true },
  { t: "error[E0502] borrow…", ok: true },
  { t: "paper.pdf", ok: true },
];
---

<section class="mx-auto max-w-[1320px] px-4 py-24 sm:px-8 sm:py-32" aria-labelledby="problem-title">
  <SectionHead num="01" kicker="the problem" id="problem-title">
    One tab for the docs.<br /><span class="text-muted">Then forty.</span>
  </SectionHead>

  <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:items-center lg:gap-16">
    <p class="max-w-[46ch] text-lg leading-relaxed text-muted">
      You open the browser to look up one function. Something autoplays. A chat pings. Twenty minutes later
      you're three videos deep and the compiler error is still there.{" "}
      <strong class="text-ink">Willpower doesn't scale. Friction does.</strong>
    </p>

    <div class="tabs-demo" data-tabs aria-hidden="true">
      <div class="browser">
        <div class="strip" data-strip>
          {start.map((tab) => <span class="tab is-ok">{tab.t}</span>)}
        </div>
        <div class="viewport">
          <div class="vp-lines"><span></span><span></span><span></span><span></span></div>
          <div class="stamp" data-stamp>
            <span class="stamp-lock">🔒</span>
            <span><b>FocusLock</b><br />back to the 3 tabs you needed</span>
          </div>
        </div>
      </div>
      <p class="counter font-mono text-sm text-muted"><b data-tab-count>3</b> tabs open</p>
    </div>
  </div>
</section>

<style is:global>
  .tabs-demo .browser {
    border: 1px solid var(--color-line); border-radius: 14px; overflow: hidden; background: #0e0e10;
    box-shadow: 0 30px 80px -40px rgb(0 0 0 / 0.9);
  }
  .tabs-demo .strip {
    display: flex; gap: 2px; padding: 8px 8px 0; background: #18181b; height: 42px; overflow: hidden;
  }
  .tabs-demo .tab {
    flex: 1 1 160px; min-width: 0; max-width: 200px; height: 34px; padding: 0 10px; border-radius: 8px 8px 0 0;
    display: flex; align-items: center; font: 500 11.5px var(--font-mono); color: #b9b9bd;
    background: #222226; white-space: nowrap; overflow: hidden; text-overflow: clip;
    transition: flex-basis 0.25s ease, background 0.25s ease, color 0.25s ease;
  }
  .tabs-demo .tab.is-ok { color: var(--color-ink); box-shadow: inset 0 2px 0 var(--color-lime); }
  .tabs-demo .tab.is-bad { color: #ffb4a6; background: #2b1a17; box-shadow: inset 0 2px 0 var(--color-danger); }
  .tabs-demo .tab.is-new { animation: pop 0.22s cubic-bezier(0.2, 1.4, 0.4, 1) both; }
  @keyframes pop { from { transform: translateY(100%) scale(0.6); opacity: 0; } }
  .tabs-demo .viewport { position: relative; height: clamp(220px, 28vw, 320px); padding: 28px; }
  .tabs-demo .vp-lines { display: grid; gap: 12px; max-width: 70%; }
  .tabs-demo .vp-lines span { height: 10px; border-radius: 5px; background: #1e1e22; }
  .tabs-demo .vp-lines span:nth-child(1) { width: 45%; height: 18px; background: #26262b; }
  .tabs-demo .vp-lines span:nth-child(3) { width: 85%; }
  .tabs-demo .vp-lines span:nth-child(4) { width: 60%; }
  .tabs-demo .stamp {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%; display: flex; gap: 14px; align-items: center;
    padding: 14px 20px; border-radius: 14px; background: var(--color-lime); color: var(--color-bg);
    font-size: 14px; line-height: 1.3; box-shadow: 0 20px 60px -10px rgb(198 255 61 / 0.45);
    opacity: 0; scale: 1.6; rotate: -6deg; pointer-events: none; white-space: nowrap;
  }
  .tabs-demo .stamp b { font-weight: 800; }
  .tabs-demo .stamp-lock { font-size: 28px; }
  .tabs-demo .stamp.is-on { animation: slam 0.45s cubic-bezier(0.3, 1.6, 0.5, 1) forwards; }
  @keyframes slam { to { opacity: 1; scale: 1; rotate: -3deg; } }
  .tabs-demo .counter { margin-top: 14px; }
  .tabs-demo .counter b { color: var(--color-ink); font-variant-numeric: tabular-nums; }
  .tabs-demo.is-chaos .counter b { color: var(--color-danger); }
  .tabs-demo.is-shake .browser { animation: shake 0.35s ease-in-out; }
  @keyframes shake { 25% { transform: translateX(-6px) rotate(-0.4deg); } 50% { transform: translateX(5px) rotate(0.3deg); } 75% { transform: translateX(-3px); } }
</style>

<script>
  const TITLES = [
    "▶ 10-min video", "inbox (3)", "▶ autoplay: next", "chat · 12 new", "news: you won't believe",
    "feed", "deals today", "▶ shorts", "why is my build slow", "forum thread", "▶ reaction to the…",
    "chat · 31 new", "weather", "▶ top 10 bugs", "feed (again)", "sports scores", "▶ lo-fi beats",
    "recipes", "chat · 54 new", "▶ part 2",
  ];
  const START = ["docs: Vec<T>", "error[E0502] borrow…", "paper.pdf"];

  const root = document.querySelector<HTMLElement>("[data-tabs]")!;
  const strip = root.querySelector<HTMLElement>("[data-strip]")!;
  const stamp = root.querySelector<HTMLElement>("[data-stamp]")!;
  const count = root.querySelector<HTMLElement>("[data-tab-count]")!;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const tab = (text: string, cls: string) => Object.assign(document.createElement("span"), { className: `tab ${cls}`, textContent: text });
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  function reset() {
    strip.replaceChildren(...START.map((t) => tab(t, "is-ok")));
    count.textContent = "3";
    root.classList.remove("is-chaos");
    stamp.classList.remove("is-on");
  }

  let running = false;
  async function play() {
    if (running) return;
    running = true;
    reset();
    await sleep(500);
    root.classList.add("is-chaos");
    for (let i = 0; i < 37; i++) {
      strip.append(tab(TITLES[i % TITLES.length], "is-bad is-new"));
      count.textContent = String(4 + i);
      await sleep(Math.max(35, 260 - i * 12));
    }
    await sleep(500);
    root.classList.add("is-shake");
    stamp.classList.add("is-on");
    await sleep(350);
    root.classList.remove("is-shake");
    for (const t of [...strip.querySelectorAll(".is-bad")]) t.remove();
    count.textContent = "3";
    root.classList.remove("is-chaos");
    await sleep(3200);
    running = false;
  }

  if (reduced) {
    stamp.classList.add("is-on");
  } else {
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) play();
      },
      { threshold: 0.6 }
    ).observe(root);
  }
</script>
