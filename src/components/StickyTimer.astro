---
---

<aside class="sticky-timer" data-sticky hidden aria-label="Demo focus session timer">
  <a href="#demo" class="st-link">
    <span class="st-lock" aria-hidden="true">🔒</span>
    <span class="st-time" data-st-time>24:59</span>
    <span class="st-pass" data-st-pass hidden></span>
    <span class="st-label">demo session</span>
  </a>
  <button type="button" class="st-close" data-st-close aria-label="Hide the floating timer">✕</button>
</aside>

<style>
  .sticky-timer {
    position: fixed; right: 20px; bottom: 20px; z-index: 40;
    display: flex; align-items: center; gap: 4px; padding: 6px 6px 6px 14px;
    background: rgb(20 20 22 / 0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--color-line); border-radius: 999px;
    box-shadow: 0 12px 40px -12px rgb(0 0 0 / 0.8);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .sticky-timer.is-away { opacity: 0; transform: translateY(12px); pointer-events: none; }
  .sticky-timer[hidden] { display: none; }
  @media (max-width: 767px) { .sticky-timer { display: none !important; } }
  .st-link { display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 13px; }
  .st-time { color: var(--color-lime); font-weight: 700; font-variant-numeric: tabular-nums; }
  .st-pass { color: var(--color-ink); font-variant-numeric: tabular-nums; }
  .st-label { color: var(--color-muted); font-size: 11.5px; }
  .st-close {
    width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center;
    color: var(--color-muted); font-size: 11px; cursor: pointer; margin-left: 4px;
  }
  .st-close:hover { background: var(--color-surface-2); color: var(--color-ink); }
</style>

<script>
  import type { TickDetail } from "../scripts/desktop";

  const KEY = "focuslock:sticky-dismissed";
  const el = document.querySelector<HTMLElement>("[data-sticky]")!;
  const time = el.querySelector<HTMLElement>("[data-st-time]")!;
  const pass = el.querySelector<HTMLElement>("[data-st-pass]")!;

  let dismissed = false;
  try {
    dismissed = sessionStorage.getItem(KEY) === "1";
  } catch {
  }

  if (!dismissed) {
    el.hidden = false;
    el.classList.add("is-away");

    document.addEventListener("focuslock:tick", (e) => {
      const d = (e as CustomEvent<TickDetail>).detail;
      time.textContent = d.session;
      pass.hidden = !d.pass;
      if (d.pass) pass.textContent = `🎟 ${d.pass}`;
    });

    const demo = document.getElementById("demo");
    if (demo) {
      new IntersectionObserver(([entry]) => el.classList.toggle("is-away", entry.isIntersecting), {
        threshold: 0.1,
      }).observe(demo);
    }

    el.querySelector("[data-st-close]")!.addEventListener("click", () => {
      el.hidden = true;
      try {
        sessionStorage.setItem(KEY, "1");
      } catch {
      }
    });
  }
</script>
